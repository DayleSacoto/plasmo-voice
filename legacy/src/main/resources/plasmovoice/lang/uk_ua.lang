# Переклади екрана налаштувань Plasmo Voice (UTF-8).
# Формат: key=value. Рядки, що починаються з #, — коментарі. \n — розрив рядка в підказках.
# Не змінюйте %s, %1$s, %d та %%.
# Відсутні ключі беруться з вбудованого тексту, а потім з англійської.
# Видаліть цей файл, щоб під час наступного запуску отримати свіжу копію з модифікації.
# Повідомлення сервера перекладаються в config/plasmovoice/languages/, а не тут.

# Екран
gui.plasmovoice.title=Налаштування %1$s %2$s
gui.plasmovoice.toggle.microphone=Перемкнути мікрофон\n%s
gui.plasmovoice.toggle.voice=Перемкнути голосовий чат\n%s
gui.plasmovoice.toggle.currently=Зараз: %s
gui.plasmovoice.toggle.enabled=УВІМКНЕНО
gui.plasmovoice.toggle.disabled=ВИМКНЕНО
gui.plasmovoice.toggle.on=Увімк.
gui.plasmovoice.toggle.off=Вимк.
gui.plasmovoice.not_available=На цьому сервері не встановлено Plasmo Voice
gui.plasmovoice.connecting=Підключення до UDP-сервера...
gui.plasmovoice.cannot_connect_to_udp=Не вдалося підключитися до UDP-сервера.\nНайімовірніше, UDP-порт закрито. Докладніше у вікі:\n%s
