# Tab „Geräte“
gui.plasmovoice.devices=Geräte
gui.plasmovoice.devices.microphone=Mikrofon
gui.plasmovoice.devices.activation_threshold=Aktivierungsschwelle
gui.plasmovoice.devices.activation_threshold.tooltip=Wird nur verwendet, wenn die Aktivierungsart auf „Sprachaktivierung“ steht.\n\nStelle den Regler auf einen Wert, den deine Lautstärke nur beim Sprechen überschreitet.
gui.plasmovoice.devices.not_available=Nicht verfügbar
gui.plasmovoice.devices.microphone_volume=Mikrofonlautstärke
gui.plasmovoice.devices.noise_suppression=Rauschunterdrückung
gui.plasmovoice.devices.noise_suppression.tooltip=RNNoise-Rauschunterdrückung.\n\nNutzt ein neuronales Netz. Funktioniert gut, kann aber viel CPU-Leistung beanspruchen.\n\nGilt für dein Mikrofon.
gui.plasmovoice.devices.stereo_capture=Stereo-Aufnahme
gui.plasmovoice.devices.stereo_capture.tooltip=Nimmt den Ton in Stereo auf und wandelt ihn dann in Mono um.\nKann die Qualität verbessern, macht den Ton aber leiser.
gui.plasmovoice.devices.disable_input_device=Eingabe deaktivieren
gui.plasmovoice.devices.disable_input_device.tooltip=Deaktiviert die Verwendung jeglicher Mikrofone vollständig.\n\nNützlich, wenn Bluetooth-Kopfhörer das Mikrofon abschalten müssen, um im Stereomodus zu bleiben.
gui.plasmovoice.devices.failed_to_initialize_microphone.tooltip=Mikrofon konnte nicht initialisiert werden\n%s\n\nWähle ein anderes Gerät oder klicke auf diese Schaltfläche, um unser Wiki mit möglichen Lösungen zu öffnen.
gui.plasmovoice.devices.output=Ausgabe
gui.plasmovoice.devices.output_device=Ausgabegerät
gui.plasmovoice.devices.volume=Lautstärke
gui.plasmovoice.devices.volume.tooltip=Eine Lautstärke über 100%% kann zu Verzerrungen führen.
gui.plasmovoice.devices.occlusion=Schallabschirmung
gui.plasmovoice.devices.occlusion.tooltip=Schickt einen Strahl von dir zu jeder Tonquelle und dämpft den Ton, wenn Blöcke im Weg sind.\n\nNützlich, wenn du Spieler in anderen Räumen nicht hören möchtest. Funktioniert aber nicht immer korrekt, daher am besten deaktiviert lassen, wenn du es nicht brauchst.
gui.plasmovoice.devices.directional_sources=Richtwirkung
gui.plasmovoice.devices.directional_sources.tooltip=Macht den Ton etwas leiser, wenn die Quelle nicht zu dir blickt und du außerhalb des eingestellten Winkels bist.\n\nGilt für die Spieler, die du hörst.
gui.plasmovoice.devices.hrtf=HRTF
gui.plasmovoice.devices.hrtf.tooltip=Verbessert die Genauigkeit der Audiopositionierung, sodass sich leichter erkennen lässt, woher ein Ton im 3D-Raum kommt.\n\nKann die Audioqualität leicht verringern.\n\nGilt für die Spieler, die du hörst.

# Tab „Lautstärke“
gui.plasmovoice.volume=Lautstärke
gui.plasmovoice.volume.sources=Quellenlautstärke
gui.plasmovoice.volume.players=Spielerlautstärke
gui.plasmovoice.volume.players_search=Suchen...
gui.plasmovoice.volume.voice_leveling=Lautstärkeausgleich
gui.plasmovoice.volume.voice_leveling.tooltip=Dreht Spieler mit lauten Mikrofonen automatisch leiser und hebt leise Stimmen sanft an, sodass alle ungefähr gleich laut klingen.\n\nReichweite, Schallabschirmung und deine Spielerlautstärken wirken weiterhin zusätzlich.\n\nGilt für die Spieler, die du hörst.
gui.plasmovoice.volume.voice_leveling_target=Zielpegel
gui.plasmovoice.volume.voice_leveling_target.tooltip=Sprachpegel, auf den die Spieler angeglichen werden.\n\nHöher bedeutet lauter.

