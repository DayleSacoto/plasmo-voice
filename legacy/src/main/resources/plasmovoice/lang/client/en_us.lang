# Devices tab
gui.plasmovoice.devices=Devices
gui.plasmovoice.devices.microphone=Microphone
gui.plasmovoice.devices.activation_threshold=Activation Threshold
gui.plasmovoice.devices.activation_threshold.tooltip=Only used when the activation type is set to “Voice Activation”.\n\nMove the slider to a point that your volume only goes above when you are talking.
gui.plasmovoice.devices.not_available=Not Available
gui.plasmovoice.devices.microphone_volume=Microphone Volume
gui.plasmovoice.devices.noise_suppression=Noise Suppression
gui.plasmovoice.devices.noise_suppression.tooltip=RNNoise noise suppression.\n\nUses a neural network. Works well, but may be CPU-intensive.\n\nApplies to your microphone.
gui.plasmovoice.devices.stereo_capture=Stereo Capture
gui.plasmovoice.devices.stereo_capture.tooltip=Captures sound in stereo, then converts it to mono.\nMay improve quality, but makes the sound quieter.
gui.plasmovoice.devices.disable_input_device=Disable Input Device
gui.plasmovoice.devices.disable_input_device.tooltip=Completely disables the use of any microphone.\n\nUseful when Bluetooth headphones need the microphone turned off to stay in stereo mode.
gui.plasmovoice.devices.failed_to_initialize_microphone.tooltip=Failed to initialize the microphone\n%s\n\nTry selecting another device, or click this button to open our wiki for possible solutions.
gui.plasmovoice.devices.output=Output
gui.plasmovoice.devices.output_device=Output Device
gui.plasmovoice.devices.volume=Volume
gui.plasmovoice.devices.volume.tooltip=Setting the volume above 100%% may cause distortion.
gui.plasmovoice.devices.occlusion=Sound Occlusion
gui.plasmovoice.devices.occlusion.tooltip=Casts a ray from you to each sound source and muffles the sound if blocks are in the way.\n\nUseful if you don't want to hear people in other rooms, but it doesn't always work correctly, so keep it disabled when you don't need it.
gui.plasmovoice.devices.directional_sources=Directional Sources
gui.plasmovoice.devices.directional_sources.tooltip=Makes the sound slightly quieter when the source isn't facing you and you are outside the specified angle.\n\nApplies to the players you hear.
gui.plasmovoice.devices.hrtf=HRTF
gui.plasmovoice.devices.hrtf.tooltip=Improves the accuracy of audio positioning, making it easier to tell where a sound is coming from in 3D space.\n\nMay slightly reduce audio quality.\n\nApplies to the players you hear.

